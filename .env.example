# Copy to .env and edit.  Load with:  set -a; source .env; set +a

# ---- API keys ----
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...                 # hosted speech-to-text
ELEVENLABS_API_KEY=...                # only if SB_TTS=elevenlabs

# ---- Audio devices (substring match, see tools.list_devices) ----
SB_INPUT_DEVICE=ReSpeaker
SB_OUTPUT_DEVICE=UACDemo              # <- name of your USB audio adapter/DAC
SB_PLAYBACK_RATE=22050
SB_OUTPUT_GAIN=1.0

# ---- Noise gate: THE setting that decides whether this works at a party ----
# Run tools.calibrate_noise DURING the party conditions, not in a quiet room.
SB_RMS_FLOOR=450
SB_VAD_AGGRESSIVENESS=3
SB_VAD_END_FRAMES=35                  # ~700ms silence ends an utterance

# ---- Half-duplex ----
# True = mic hard-muted while speaking. Safe default; no barge-in.
# False = rely on ReSpeaker hardware AEC; guests can interrupt.
SB_HALF_DUPLEX=true

# ---- Vision ----
SB_VISION=true
SB_MIN_BOX_HEIGHT=0.30                # raise to ignore people further away
SB_DETECT_THRESHOLD=0.45
SB_COSTUME_VISION=true                # send a still so it can riff on costumes

# ---- Servos ----
SB_SERVOS=true
SB_JAW_ALPHA=0.55
SB_TRACK_ALPHA=0.12

# ---- Brain ----
SB_MODEL=claude-sonnet-5
SB_MAX_TOKENS=160
SB_CONVO_TIMEOUT_S=45
SB_PERSONA=persona.md

# ---- Speech ----
SB_STT=openai                         # openai | faster-whisper
SB_TTS=elevenlabs                     # elevenlabs | openai | piper
SB_VOICE_ID=onwK4e9ZLuTAKqWW03F9
SB_TTS_MODEL=eleven_flash_v2_5

# ---- Pacing ----
SB_LISTEN_TIMEOUT_S=10
SB_GREET_COOLDOWN_S=30
SB_LOG_LEVEL=INFO
