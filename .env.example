# Copy to .env and edit.  Load with:  set -a; source .env; set +a

# ---- API keys ----
ANTHROPIC_API_KEY=sk-ant-...
# Speech runs on mini (deploy/mini, `make mini`): an OpenAI-compatible server,
# so the openai client is reused with a placeholder key.
OPENAI_BASE_URL=http://mini.local:8000/v1
OPENAI_API_KEY=unused                 # sk-... only if pointing at real OpenAI
ELEVENLABS_API_KEY=...                # only if SB_TTS=elevenlabs

# ---- Audio devices (substring match, see tools.list_devices) ----
SB_INPUT_DEVICE=ReSpeaker
SB_OUTPUT_DEVICE=NS-MCX321K           # <- name of your USB audio adapter/DAC
SB_PLAYBACK_RATE=22050
SB_OUTPUT_GAIN=1.0

# ---- Noise gate: THE setting that decides whether this works at a party ----
# Run tools.calibrate_noise DURING the party conditions, not in a quiet room.
SB_RMS_FLOOR=450
SB_VAD_AGGRESSIVENESS=3
SB_VAD_END_FRAMES=35                  # ~700ms silence ends an utterance

# ---- Half-duplex ----
# True = mic hard-muted while speaking. Safe default; no barge-in.
# False = rely on ReSpeaker hardware AEC; guests can interrupt.
SB_HALF_DUPLEX=true

# ---- Vision ----
SB_VISION=true
SB_MIN_BOX_HEIGHT=0.30                # raise to ignore people further away
SB_DETECT_THRESHOLD=0.45
SB_COSTUME_VISION=true                # send a still so it can riff on costumes

# ---- Servos ----
SB_SERVOS=true
SB_JAW_ALPHA=0.55
SB_JAW_CLOSED_DEG=83                  # 1-2 deg short of the jaw's physical stop (82); past it, it grinds
SB_JAW_OPEN_DEG=125
SB_EYES_CHANNEL=15                    # PCA9685 channel for the LED eyes; -1 = off
SB_EYES_PERIOD_S=2.0                  # one fade cycle, dark -> bright -> dark
SB_TRACK_ALPHA=0.12

# ---- Brain ----
SB_MODEL=claude-sonnet-5-5
SB_THINKING=between_tools             # sonnet-5: disabled; haiku-4-5: empty
SB_EFFORT=low                         # haiku-4-5: empty
SB_MAX_TOKENS=160
SB_CONVO_TIMEOUT_S=45
# Stay quiet until someone says this; empty = greet guests on sight
SB_WAKE_PHRASE=hello bones
# How many past greetings it remembers to spot repeat costumes (0 = off)
SB_GREETING_MEMORY=5
SB_PERSONA=persona.md

# ---- Speech ----
SB_STT=openai                         # openai | faster-whisper
SB_STT_MODEL=Systran/faster-distil-whisper-small.en
SB_TTS=openai                         # elevenlabs | openai | piper
SB_OPENAI_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
SB_OPENAI_VOICE=am_onyx
SB_TTS_SPEED=1.0                      # 0.8 slower/more deliberate, 1.2 brisker
SB_OPENAI_TTS_RATE=22050              # = SB_PLAYBACK_RATE; mini resamples for us
SB_VOICE_ID=onwK4e9ZLuTAKqWW03F9      # elevenlabs only
SB_TTS_MODEL=eleven_flash_v2_5        # elevenlabs only

# ---- Pacing ----
SB_LISTEN_TIMEOUT_S=10
SB_GREET_COOLDOWN_S=30
SB_LOG_LEVEL=INFO
