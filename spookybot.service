[Unit]
Description=Halloween talking head
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=kbedwell
SupplementaryGroups=audio video i2c gpio
WorkingDirectory=/home/kbedwell/spookybot
# Sourced through bash rather than EnvironmentFile= because .env carries
# trailing "# comments", which systemd would keep as part of the value.
ExecStart=/bin/bash -c 'set -a; . ./.env; set +a; exec .venv/bin/python -m spookybot.main'
Restart=always
RestartSec=5
# Audio callbacks miss deadlines when the scheduler is busy; a small nice
# bump keeps playback clean when the LLM call and the camera thread collide.
Nice=-5

[Install]
WantedBy=multi-user.target
